# Gemini flight coach. Stays on the server. Leave blank to skip the coach.
GEMINI_API_KEY=

# Model name sent with the coach request. Change this to switch models.
GEMINI_MODEL=gemini-3.5-flash

# MongoDB Atlas connection string for the shared leaderboard. Leave blank to keep scores on this browser only.
MONGODB_URI=

# Database and collection for leaderboard scores.
MONGODB_DB=HackRPI
MONGODB_COLLECTION=hackrpi

# Port the Express server listens on.
PORT=3000

# Tiger Cloud connection string for flight telemetry. Leave blank to keep flights in memory.
TIGERDATA_URI=

# Admin token for deleting stored flights. Leave blank to refuse every delete.
ADMIN_TOKEN=
