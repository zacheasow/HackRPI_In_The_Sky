# Gemini flight coach. Stays on the server. Leave blank to skip the coach.
GEMINI_API_KEY=

# Model name sent with the coach request. Change this to switch models.
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas connection string for the shared leaderboard. Leave blank to keep scores on this browser only.
MONGODB_URI=

# Port the Express server listens on.
PORT=3000
